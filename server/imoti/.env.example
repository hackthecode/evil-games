# Копирайте този файл като .env и променете стойностите при нужда.

# Име на играта (показва се в интерфейса)
GAME_NAME=Имоти и Империи

# Адрес и порт на сървъра
HOST=0.0.0.0
PORT=8000

# Таен ключ за подписване на reconnect токени.
# Генерирайте свой: python -c "import secrets; print(secrets.token_hex(32))"
# Ако е празен, ключът се създава автоматично в data/.secret_key и се пази
# между рестартиранията, за да останат валидни токените за свързване.
SECRET_KEY=

# Колко секунди се пази мястото на изключен играч
DISCONNECT_GRACE_SECONDS=180

# Rate limiting: брой събития за прозорец от секунди
RATE_LIMIT_EVENTS=20
RATE_LIMIT_WINDOW=5
