# Междинни файлове на Python
__pycache__/
*.pyc
.venv/
.env
.pytest_cache/

# Данни на играта. Запазените партии и ключът НЕ се версионират: те са
# живо състояние, а не код — при връщане към стара версия партиите ви
# трябва да останат непокътнати.
data/game.db
data/game.db-journal
data/game.db.bak-*
data/.secret_key
data/.dice_next
data/.dice_next.tmp

# Дневници на приставката за памет — растат с всяка сесия.
.remember/

# ВАЖНО: data/board_config.json НЕ е тук нарочно. Таблото е съдържание на
# играта; без него върната версия не тръгва.

# Статичната версия за GitHub Pages се сглобява от build_pages.py.
_site/

# Локални помощни инструменти — не се публикуват.
cheat.bat
cheat_dice.py
